{
  "format_version": 1,
  "sdk_version": 5,
  "id": "example.motionstudio.gain",
  "version": "0.2.0",
  "name": "自定义增益 / Custom Gain",
  "author": "Your name",
  "license": "MIT",
  "effects": [
    {
      "id": "gain",
      "name": "增益",
      "english_name": "Custom Gain",
      "category": "Custom",
      "params": [
        {
          "id": "gain",
          "name": "增益",
          "kind": "float",
          "default": [
            1,
            0,
            0,
            0
          ],
          "min": 0,
          "max": 4,
          "step": 0.01,
          "units": "倍",
          "animatable": true
        }
      ],
      "passes": [
        {
          "shader": "shaders/gain.wgsl",
          "entry": "main_fx"
        }
      ],
      "working_space": "srgb",
      "alpha_mode": "straight",
      "edge_mode": "transparent",
      "required_capabilities": [
        "single_frame",
        "color_profile",
        "native_plugin_editor"
      ],
      "native_editor": {
        "id": "example.motionstudio.gain.editor",
        "protocol": 1,
        "title": "增益编辑器",
        "sections": [
          {
            "id": "preview",
            "title": "预览",
            "slots": [
              {
                "kind": "preview",
                "max_size": 512
              },
              {
                "kind": "timeline"
              }
            ]
          },
          {
            "id": "adjust",
            "title": "增益",
            "slots": [
              {
                "kind": "parameters",
                "params": [
                  "gain"
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
